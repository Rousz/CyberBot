# CyberBot gizli ayarlari - SADECE PC'de ".env" adiyla durur. GitHub'a ASLA gitmez.
# setup_env.bat bu dosyadan .env olusturur ve Not Defteri'nde acar.
# Esittir isaretinden sonra BOSLUK ve TIRNAK olmadan yaz.
# Ornek:  TELEGRAM_TOKEN=123456789:AAH...
# .env icerigini kimseyle paylasma, sohbete de yapistirma.

# Telegram - BotFather'in verdigi "HTTP API" token'i
TELEGRAM_TOKEN=
# Chat id - simdilik bos birak; 01_connection_test.bat sana ekranda gosterecek
TELEGRAM_CHAT_ID=

# WEEX API - demo test icin GEREKMEZ, canli asamada doldurulacak. Simdilik bos birak.
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_API_PASSPHRASE=
