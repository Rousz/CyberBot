# Satir sonlari: Windows .bat dosyalari CRLF, Docker icinde calisan her sey LF.
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.zip binary
*.feather binary
*.parquet binary
*.png binary
*.jpg binary
*.sqlite binary
